# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- Google ---------------------------------------------------------------
# Path to the service-account JSON key. Keep the file itself outside the repo.
#
# The step that is easy to miss: a service account has its own email address,
# and the target Drive folder must be SHARED with that address. Without the
# share, every write fails with a permission error that reads like a bug in
# the code rather than a missing grant.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Drive folder the pipeline writes finished documents into.
BCT_DRIVE_FOLDER_ID=

# --- Hugging Face ---------------------------------------------------------
HF_TOKEN=

# --- Weights & Biases -----------------------------------------------------
WANDB_API_KEY=
WANDB_PROJECT=bct-qwen-translation-vn

# --- Local paths ----------------------------------------------------------
BCT_BIBLE_DB=data/bible.sqlite
